---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { value: '3,250+', label: 'Beneficiaries empowered' },
  { value: '100+', label: 'Educators trained' },
  { value: '45+', label: 'Events hosted' },
  { value: '10+', label: 'Partnerships' },
];

const timeline = [
  { year: '2020', label: 'The spark', body: 'The idea is born — out of a gap between the potential of African youth and the STEM infrastructure available to them.' },
  { year: '2021', label: 'Founded', body: 'STEMCity Labs is established in Kampala, with a mission to build vibrant STEM ecosystems across the continent.' },
  { year: '2022', label: 'First cohort', body: 'First community programs reach 500 students and 50 educators in our inaugural year.' },
  { year: '2025', label: 'Tujulize launches', body: 'Tujulize Uganda goes live — a civic-tech platform that puts public-engagement tools directly into citizens\' hands.' },
  { year: '2040', label: 'The continental goal', body: 'Ten million students and youth reached across Africa. This is the ambition we\'re building toward, one cohort at a time.' },
];

const practices = [
  {
    title: 'We build, we don\'t just teach.',
    body: 'We ship our own platforms. EVO is our STEM learning system. Tujulize Uganda is our civic-tech tool. Our learners use what we make.',
  },
  {
    title: 'We measure everything.',
    body: 'A dedicated MEAL function — monitoring, evaluation, accountability, learning — tracks every program. The numbers we publish are audited, not aspirational.',
  },
  {
    title: 'Pipeline, not silo.',
    body: 'We work across the whole learner journey: kids in Maker Club through to first-time founders. Most STEM orgs pick one stage. We refuse to.',
  },
  {
    title: 'Anchored in Kampala. Built for Africa.',
    body: 'We don\'t import frameworks from outside the continent. We build from the context we live in, and let the work travel from there.',
  },
];

const leadership = [
  {
    name: 'Brian Byaruhanga',
    role: 'Board Chair · Technology advisor',
    level: 'Board',
    bio: 'Civic technologist and human-rights advocate. Background in application development, ICT infrastructure security, and digital forensics. Certified digital security and adult literacy trainer.',
  },
  {
    name: 'Rosebella Nsita Kibaya',
    role: 'Board member',
    level: 'Board',
    bio: 'Strategic leader with a track record in stakeholder management and program implementation across the non-profit sector. Former Regional Manager, Central Uganda, at Fundi Bots.',
  },
  {
    name: 'Ssozi Arthur Roykin',
    role: 'Operations lead',
    level: 'Team',
    bio: '7+ years leading data-driven initiatives and digital transformation across Uganda\'s technology, agricultural, and youth sectors. Implemented ODOO ERP for 15+ organisations. Power BI and analytics expert.',
  },
  {
    name: 'Joshua Mwesigwa Warren',
    role: 'Legal lead',
    level: 'Team',
    bio: 'Educational-technology law and civic-engagement frameworks. Ensures STEMCity\'s operations align with regulatory and governance requirements as the org scales.',
  },
  {
    name: 'Eyotaru Hope',
    role: 'MEAL lead',
    level: 'Team',
    bio: 'Monitoring and Evaluation Officer with 6+ years in data management and information systems. Expert in SPSS, Python, Power BI, Tableau. Prior project experience with UNHCR, USAID, and PEPFAR.',
  },
];

const ctas = [
  { label: 'Volunteer with our programs', href: '/get-involved', tag: 'For individuals' },
  { label: 'Partner — schools & orgs', href: '/partners', tag: 'For institutions' },
  { label: 'Fund the work', href: '/donate', tag: 'For funders & VCs' },
  { label: 'See open roles', href: '/careers', tag: 'For job seekers' },
];
---

<Layout
  title="About — STEMCity Labs"
  description="STEMCity Labs is a STEM and civic-tech innovation hub anchored in Kampala, Uganda, building infrastructure for African innovation from kids through founders."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-12 sm:pt-20 pb-12 sm:pb-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        About STEMCity Labs
      </p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        Africa needs a place where a twelve-year-old writes her first line of code, a university student ships her first product, and a founder finds her first customer. <em class="text-brand italic">We're building that place.</em>
      </h1>
    </section>

    <section class="px-6 sm:px-10 py-12 sm:py-16 grid lg:grid-cols-12 gap-8 lg:gap-16 border-t border-ink/10">
      <div class="lg:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand mb-4">What we do</p>
        <p class="font-display text-2xl sm:text-3xl leading-snug tracking-[-0.015em] text-ink">
          STEMCity Labs is a STEM-education and civic-technology hub. We run programs across the full learner pipeline — Maker Club for kids, bootcamps for teens, capstones for university students, founder support for entrepreneurs — and we build the platforms (EVO, Tujulize Uganda) that the programs run on.
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-4">Where</p>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between gap-4 border-b border-ink/10 pb-3">
            <dt class="text-mute">Headquartered</dt>
            <dd class="font-medium text-right">TechBuzz Hub, Ntinda · Kampala</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-ink/10 pb-3">
            <dt class="text-mute">Active</dt>
            <dd class="font-medium text-right">Across Uganda</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-ink/10 pb-3">
            <dt class="text-mute">Reach</dt>
            <dd class="font-medium text-right">9 countries via partners</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-mute">Founded</dt>
            <dd class="font-medium text-right">2021</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="px-6 sm:px-10 py-10 sm:py-12 border-t border-ink/10">
      <div class="flex items-baseline justify-between mb-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute">Traction · since 2021</p>
        <span class="font-mono text-[11px] tracking-[0.12em] text-mute">Audited quarterly</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {stats.map((s) => (
          <div>
            <div class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium tracking-[-0.02em] leading-none">{s.value}</div>
            <div class="text-xs text-mute mt-2">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="px-6 sm:px-10 py-12 sm:py-16 border-t border-ink/10">
      <div class="mb-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-4">Our story</p>
        <h2 class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.02em]">From a Kampala spark to a continental ambition.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {timeline.map((t) => (
          <div class="border-t border-ink/15 pt-4">
            <div class="font-mono text-[11px] tracking-[0.08em] text-brand">{t.year}</div>
            <div class="font-display text-lg mt-2 font-medium">{t.label}</div>
            <p class="text-sm text-ink-soft mt-2 leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-brand text-brand-ink px-6 sm:px-10 py-16 sm:py-24">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand-deep mb-6">The 2040 ambition</p>
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        <div class="lg:col-span-7">
          <div class="font-display font-medium leading-[0.92] tracking-[-0.04em] text-[6rem] sm:text-[8rem] lg:text-[11rem]">10M</div>
          <p class="font-display text-2xl sm:text-3xl mt-2 max-w-xl leading-snug">
            students and youth reached across Africa by 2040.
          </p>
        </div>
        <div class="lg:col-span-5 text-sm sm:text-base leading-relaxed text-brand-deep max-w-md space-y-4">
          <p>We're 3,250 students in today. That's a fraction of a percent of where we're going — and the gap is exactly the point.</p>
          <p>Africa's median age is 19. The continent will add a billion people by 2050. Either they'll be ready to build the systems they inherit, or someone else will build those systems for them. STEMCity Labs is here for option one.</p>
        </div>
      </div>
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-12 sm:py-16">
      <div class="mb-8 flex items-baseline justify-between">
        <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.02em]">How we work.</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-paper/60">Four practices</span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {practices.map((p, i) => (
          <div class="p-6 rounded-xl bg-paper/[0.06] border border-paper/10">
            <div class="font-mono text-[11px] tracking-[0.08em] text-brand mb-3">0{i + 1}</div>
            <div class="font-display text-xl font-medium leading-snug">{p.title}</div>
            <p class="text-sm text-paper/75 mt-3 leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="px-6 sm:px-10 py-12 sm:py-16 border-t border-ink/10">
      <div class="mb-8 flex items-baseline justify-between flex-wrap gap-3">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-3">Leadership</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.02em]">The people accountable for the work.</h2>
        </div>
        <span class="font-mono text-[11px] tracking-[0.12em] text-mute">Board · Team</span>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {leadership.map((p) => (
          <div class="p-6 rounded-xl border border-ink/10 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-[10px] tracking-[0.1em] uppercase px-2 py-1 rounded-full border border-ink/15 text-mute">{p.level}</span>
            </div>
            <div class="font-display text-xl font-medium">{p.name}</div>
            <div class="font-mono text-[11px] tracking-[0.06em] text-brand mt-1">{p.role}</div>
            <p class="text-sm text-ink-soft mt-4 leading-relaxed flex-1">{p.bio}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="px-6 sm:px-10 py-12 sm:py-16 border-t border-ink/10">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-4">Work with us</p>
      <h2 class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.02em] mb-8 max-w-2xl">Four ways to plug in — pick the one that fits.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {ctas.map((c) => (
          <a
            href={c.href}
            class="group p-6 rounded-xl border border-ink/10 hover:border-brand hover:bg-brand/5 transition flex flex-col gap-3"
          >
            <span class="font-mono text-[10px] tracking-[0.1em] uppercase text-mute">{c.tag}</span>
            <span class="font-display text-lg font-medium leading-snug flex-1">{c.label}</span>
            <span class="text-brand text-sm font-medium inline-flex items-center gap-1">
              Go <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
