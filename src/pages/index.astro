---
import Layout from '../layouts/Layout.astro';
---

<Layout title="STEMCity Labs — redesign in progress">
  <main class="min-h-screen flex flex-col">
    <header class="px-6 sm:px-10 py-6 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 rounded-full bg-brand"></span>
        <span class="font-semibold tracking-tight">STEMCity Labs</span>
      </div>
      <span class="text-xs uppercase tracking-[0.18em] text-mute">Redesign · v0</span>
    </header>

    <section class="flex-1 flex items-center px-6 sm:px-10">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.2em] text-brand mb-6">Step 1 · Foundation</p>
        <h1 class="font-display text-5xl sm:text-7xl font-semibold leading-[1.02] tracking-tight">
          A new home for <span class="text-brand">Africa's</span> next generation of innovators.
        </h1>
        <p class="mt-8 text-lg sm:text-xl text-mute max-w-2xl leading-relaxed">
          Scaffold is live. Astro + Tailwind running, design tokens stubbed, base layout in place.
          Colour and type below are placeholders — we lock the visual system in Phase 2.
        </p>

        <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl">
          <div class="h-16 rounded-lg bg-paper border border-ink/10 flex items-end p-2 text-[10px] uppercase tracking-wider text-mute">Paper</div>
          <div class="h-16 rounded-lg bg-ink flex items-end p-2 text-[10px] uppercase tracking-wider text-paper/70">Ink</div>
          <div class="h-16 rounded-lg bg-brand flex items-end p-2 text-[10px] uppercase tracking-wider text-paper/90">Brand</div>
          <div class="h-16 rounded-lg bg-accent flex items-end p-2 text-[10px] uppercase tracking-wider text-paper/90">Accent</div>
        </div>
      </div>
    </section>

    <footer class="px-6 sm:px-10 py-6 border-t border-ink/10 text-xs text-mute flex flex-wrap gap-4 justify-between">
      <span>stemcitylabs.org · redesign in progress</span>
      <span>Next: Phase 2 — design system, nav, footer</span>
    </footer>
  </main>
</Layout>
