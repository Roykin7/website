---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const audiences = [
  { age: '5–12', label: 'Kids', tag: 'Maker Club, after-school' },
  { age: '13–18', label: 'Teens', tag: 'Bootcamps, robotics' },
  { age: '18+', label: 'University', tag: 'Capstones, internships' },
  { age: 'Build', label: 'Entrepreneurs', tag: 'Incubation, cohorts' },
];

const stats = [
  { value: '3,250+', label: 'Beneficiaries empowered' },
  { value: '100+', label: 'Educators trained' },
  { value: '45+', label: 'Events hosted' },
  { value: '10+', label: 'Partnerships' },
];

const partners = ['Partner one', 'Partner two', 'Partner three', 'Partner four'];
---

<Layout title="STEMCity Labs — Where Africa's makers, students, and founders build what's next.">
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-12 sm:pt-20 pb-12 sm:pb-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        African innovation hub · est. 2021
      </p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-medium leading-[1.03] tracking-[-0.025em] max-w-4xl">
        Where Africa's <em class="text-brand italic">makers, students,</em> and <em class="text-accent italic">founders</em> build what's next.
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-xl">
        From after-school maker clubs to university capstones to founder programs — we work with everyone shaping Africa's tech future.
      </p>
      <div class="mt-8 flex flex-wrap gap-2.5">
        <a
          href="/programs"
          class="text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand transition inline-flex items-center gap-1.5"
        >
          Explore programs <span aria-hidden="true">→</span>
        </a>
        <a
          href="/partners"
          class="text-sm px-5 py-3 border border-ink/20 text-ink rounded-full hover:border-ink/40 hover:bg-ink/5 transition inline-flex items-center"
        >
          For partners &amp; investors
        </a>
      </div>
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-10 sm:py-12">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em]">A home for everyone building.</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-paper/60">Five audiences</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
        {audiences.map((a) => (
          <div class="p-3.5 rounded-xl bg-paper/[0.06] border border-paper/10 hover:bg-paper/[0.09] transition">
            <div class="font-mono text-[11px] tracking-[0.08em] text-brand">{a.age}</div>
            <div class="font-medium mt-2 text-sm">{a.label}</div>
            <div class="text-[11px] text-paper/70 mt-1 leading-snug">{a.tag}</div>
          </div>
        ))}
        <div class="p-3.5 rounded-xl bg-brand">
          <div class="font-mono text-[11px] tracking-[0.08em] text-brand-deep">Capital</div>
          <div class="font-medium mt-2 text-sm text-brand-ink">Partners &amp; VCs</div>
          <div class="text-[11px] text-brand-deep mt-1 leading-snug">Talent, co-investment</div>
        </div>
      </div>
    </section>

    <section class="px-6 sm:px-10 py-10 sm:py-12 grid grid-cols-2 sm:grid-cols-4 gap-6 border-b border-ink/10">
      {stats.map((s) => (
        <div>
          <div class="font-display text-3xl sm:text-4xl font-medium tracking-[-0.02em] leading-none">{s.value}</div>
          <div class="text-xs text-mute mt-2">{s.label}</div>
        </div>
      ))}
    </section>

    <section class="px-6 sm:px-10 py-6 flex flex-wrap items-center justify-between gap-3">
      <span class="font-mono text-[11px] tracking-[0.12em] text-mute">Backed by</span>
      <div class="flex flex-wrap gap-5 opacity-55">
        {partners.map((p) => (
          <span class="font-display text-sm font-medium">{p}</span>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
