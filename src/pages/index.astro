---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const slides = [
  { type: 'video', src: '/media/bukedea.mp4', poster: '/images/site/dt1.jpg', caption: 'In the field · Bukedea community' },
  { type: 'image', src: 'dt2', alt: 'Digital Skills Training session in Uganda', caption: 'Digital skills training · Uganda' },
  { type: 'image', src: 'teachers-session', alt: 'STEMCity teacher training session', caption: 'Teacher training session · Kampala' },
  { type: 'image', src: '1e8a4886', alt: 'STEMCity Labs community event', caption: 'Community gathering' },
  { type: 'image', src: 'dt3', alt: 'Hands-on STEM training day', caption: 'Hands-on training day' },
];

const audiences = [
  { age: '5–12', label: 'Kids', tag: 'Maker Club, after-school' },
  { age: '13–18', label: 'Teens', tag: 'Bootcamps, robotics' },
  { age: '18+', label: 'University', tag: 'Capstones, internships' },
  { age: 'Build', label: 'Entrepreneurs', tag: 'Incubation, cohorts' },
];

const stats = [
  { value: 3250, suffix: '+', label: 'Beneficiaries empowered' },
  { value: 100, suffix: '+', label: 'Educators trained' },
  { value: 45, suffix: '+', label: 'Events hosted' },
  { value: 10, suffix: '+', label: 'Partnerships' },
];
---

<Layout title="STEMCity Labs — Where Africa's makers, students, and founders build what's next.">
  <Nav />

  <main>
    <section
      id="hero"
      class="hero relative isolate overflow-hidden bg-ink text-paper px-6 sm:px-10 pt-10 sm:pt-20 pb-16 sm:pb-20 min-h-[460px] sm:min-h-[560px] flex items-center"
    >
      <div class="absolute inset-0 -z-20">
        {slides.map((s, i) => (
          <div
            class:list={[
              'slide absolute inset-0 transition-opacity duration-1000',
              i === 0 ? 'opacity-100' : 'opacity-0',
            ]}
            data-slide={i}
          >
            {s.type === 'video' ? (
              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={s.poster}
                aria-hidden="true"
                class="w-full h-full object-cover"
              >
                <source src={s.src} type="video/mp4" />
              </video>
            ) : (
              <picture>
                <source srcset={`/images/site/${s.src}.webp`} type="image/webp" />
                <img
                  src={`/images/site/${s.src}.jpg`}
                  alt={s.alt}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              </picture>
            )}
          </div>
        ))}
      </div>

      <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-br from-ink/85 via-ink/65 to-ink/85 -z-10"></div>

      <div class="relative max-w-4xl">
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-paper/70 mb-5 flex items-center gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
          African innovation hub · est. 2021
        </p>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-medium leading-[1.03] tracking-[-0.025em]">
          Where Africa's <em class="text-brand italic">makers, students,</em> and <em class="text-accent-light italic">founders</em> build what's next.
        </h1>
        <p class="mt-6 text-base sm:text-lg leading-relaxed text-paper/80 max-w-xl">
          From after-school maker clubs to university capstones to founder programs — we work with everyone shaping Africa's tech future.
        </p>
        <div class="mt-8 flex flex-wrap gap-2.5">
          <a
            href="/programs"
            class="text-sm font-medium px-5 py-3 bg-paper text-ink rounded-full hover:bg-brand hover:text-paper transition inline-flex items-center gap-1.5"
          >
            Explore programs <span aria-hidden="true">→</span>
          </a>
          <a
            href="/get-involved#partnerships"
            class="text-sm px-5 py-3 border border-paper/30 text-paper rounded-full hover:border-paper hover:bg-paper/5 transition inline-flex items-center"
          >
            For partners &amp; investors
          </a>
        </div>
      </div>

      <div class="absolute bottom-5 sm:bottom-7 left-6 sm:left-10 right-6 sm:right-10 flex items-center justify-between gap-6 z-10">
        <div class="flex items-center gap-2 font-mono text-[10px] sm:text-[11px] tracking-[0.12em] text-paper/80 uppercase min-w-0">
          <span class="w-1.5 h-1.5 rounded-full bg-brand flex-shrink-0"></span>
          {slides.map((s, i) => (
            <span data-caption={i} class:list={['truncate', i === 0 ? '' : 'hidden']}>{s.caption}</span>
          ))}
        </div>
        <div class="flex gap-1.5 flex-shrink-0">
          {slides.map((s, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`Go to slide ${i + 1}`}
              class:list={[
                'dot w-2 h-2 rounded-full transition',
                i === 0 ? 'bg-paper' : 'bg-paper/30 hover:bg-paper/60',
              ]}
            ></button>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-10 sm:py-12">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em]">A home for everyone building.</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-paper/60">Five audiences</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
        {audiences.map((a) => (
          <div class="p-3.5 rounded-xl bg-paper/[0.06] border border-paper/10 hover:bg-paper/[0.09] transition">
            <div class="font-mono text-[11px] tracking-[0.08em] text-brand">{a.age}</div>
            <div class="font-medium mt-2 text-sm">{a.label}</div>
            <div class="text-[11px] text-paper/70 mt-1 leading-snug">{a.tag}</div>
          </div>
        ))}
        <div class="p-3.5 rounded-xl bg-brand">
          <div class="font-mono text-[11px] tracking-[0.08em] text-brand-deep">Capital</div>
          <div class="font-medium mt-2 text-sm text-brand-ink">Partners &amp; VCs</div>
          <div class="text-[11px] text-brand-deep mt-1 leading-snug">Talent, co-investment</div>
        </div>
      </div>
    </section>

    <section class="px-6 sm:px-10 py-8">
      <figure class="rounded-3xl overflow-hidden">
        <picture>
          <source srcset="/images/site/dt1.webp" type="image/webp" />
          <img
            src="/images/site/dt1.jpg"
            alt="STEMCity Labs Digital Skills Training in Uganda"
            loading="lazy"
            decoding="async"
            class="w-full aspect-[16/9] sm:aspect-[21/9] object-cover"
          />
        </picture>
        <figcaption class="font-mono text-[11px] text-mute mt-3 tracking-[0.06em] flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
          In the field · Digital Skills Training, Uganda
        </figcaption>
      </figure>
    </section>

    <section class="px-6 sm:px-10 py-10 sm:py-14 border-y border-ink/10">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-ink/10 -mx-1">
        {stats.map((s) => (
          <div class="px-4 sm:px-6 first:pl-0 last:pr-0">
            <div
              class="font-display text-2xl sm:text-3xl lg:text-4xl font-medium tracking-[-0.02em] leading-none"
              data-counter={s.value}
              data-suffix={s.suffix}
            >0{s.suffix}</div>
            <div class="text-xs text-mute mt-3">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const slides = document.querySelectorAll<HTMLElement>('[data-slide]');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-dot]');
  const captions = document.querySelectorAll<HTMLElement>('[data-caption]');
  const hero = document.getElementById('hero');
  const video = slides[0]?.querySelector('video');
  let current = 0;
  let timer: number | null = null;
  const INTERVAL = 7000;

  function show(i: number) {
    slides.forEach((s, idx) => {
      s.classList.toggle('opacity-0', idx !== i);
      s.classList.toggle('opacity-100', idx === i);
    });
    dots.forEach((d, idx) => {
      d.classList.toggle('bg-paper', idx === i);
      d.classList.toggle('bg-paper/30', idx !== i);
    });
    captions.forEach((c, idx) => c.classList.toggle('hidden', idx !== i));
    if (video) {
      if (i === 0) video.play().catch(() => {});
      else video.pause();
    }
    current = i;
  }

  function start() {
    if (timer == null) timer = window.setInterval(() => show((current + 1) % slides.length), INTERVAL);
  }
  function stop() {
    if (timer != null) { clearInterval(timer); timer = null; }
  }

  dots.forEach((d, i) => {
    d.addEventListener('click', () => { stop(); show(i); start(); });
  });

  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) start();
      else { stop(); if (video) video.pause(); }
    }, { threshold: 0.1 }).observe(hero);
  } else {
    start();
  }
</script>
