---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const comingUp = [
  { audience: 'A Maker Club student', body: 'How a thirteen-year-old built her first robot and what she made next.' },
  { audience: 'An EVO graduate', body: 'From a public-school classroom to a first software internship.' },
  { audience: 'A Tujulize developer', body: 'Why an open civic-tech platform mattered to a Kampala community.' },
  { audience: 'A Digital Workplace founder', body: 'The bridge between training and a first paying customer.' },
];
---

<Layout
  title="Stories — STEMCity Labs"
  description="Profiles, outcomes, and journeys from the students, educators, founders, and partners who pass through STEMCity Labs."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-8 sm:pt-14 pb-10 sm:pb-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        Stories
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        The people behind the <em class="text-brand italic">numbers.</em>
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-2xl">
        We're collecting and writing them now. Profiles, outcomes, and journeys from the students, educators, founders, and partners who pass through STEMCity Labs.
      </p>
    </section>

    <section class="px-6 sm:px-10 py-10 sm:py-14 border-t border-ink/10">
      <div class="p-8 sm:p-12 rounded-2xl border border-ink/10 bg-ink/[0.02]">
        <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-mute mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-mute"></span>
          In progress
        </span>
        <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.02em] leading-tight max-w-2xl">
          The stories page is being written.
        </h2>
        <p class="text-ink-soft leading-relaxed mt-4 max-w-xl">
          Real interviews take time — and we'd rather wait and tell them well than ship placeholder testimonials. The first batch lands in the next program cycle.
        </p>
      </div>
    </section>

    <section class="px-6 sm:px-10 py-10 sm:py-14 border-t border-ink/10">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
        <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.02em]">What's coming</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-mute">4 in progress</span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {comingUp.map((s, i) => (
          <div class="p-6 rounded-2xl border border-ink/10 border-dashed">
            <span class="font-display text-3xl text-brand/40 font-medium leading-none">0{i + 1}</span>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-4">{s.audience}</p>
            <p class="font-display text-lg font-medium mt-2 leading-snug">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-10 sm:py-14">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand mb-3">Have a story to share?</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] leading-tight">If STEMCity changed something for you, tell us.</h2>
          <p class="mt-3 text-paper/75">Alumni, parents, partners, founders — we want to hear from you for an upcoming feature.</p>
        </div>
        <div class="lg:col-span-5 flex flex-wrap gap-2.5">
          <a href="mailto:stemcitylabs@gmail.com?subject=Story%20submission" class="text-sm font-medium px-5 py-3 bg-paper text-ink rounded-full hover:bg-brand hover:text-paper transition inline-flex items-center gap-1.5">
            Submit a story <span aria-hidden="true">→</span>
          </a>
          <a href="/contact" class="text-sm px-5 py-3 border border-paper/30 text-paper rounded-full hover:border-paper hover:bg-paper/5 transition">
            Or use the form
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
