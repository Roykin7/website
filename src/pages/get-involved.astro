---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { value: '1', label: 'Open volunteer role' },
  { value: '0', label: 'Active tenders' },
  { value: '15+', label: 'Partner organisations' },
];

const role = {
  title: 'Operations Volunteer',
  location: 'Flexible · Remote or on-site, Kampala',
  body: 'Help us deliver innovative programs, mentor students, and create lasting community impact. You\'ll work across operations, programs, and partnerships.',
  steps: [
    'Apply online — send application and portfolio to stemcitylabs@gmail.com with subject "Operations Volunteer Application — [Your Name]".',
    'Initial review — the team reviews qualifications and shortlists candidates.',
    'Interview — virtual or in-person, depending on availability.',
    'Welcome to the team.',
  ],
  requirements: ['Cover letter', 'Resume / CV', 'Portfolio (if applicable)', 'Two references'],
};

const partnershipTypes = [
  { title: 'Strategic partnerships', body: 'Join forces to scale impact through shared resources, expertise, and networks.' },
  { title: 'Technology collaboration', body: 'Develop innovative solutions, share technical expertise, and co-create platforms.' },
  { title: 'Community impact', body: 'Partner with local communities to keep our programs culturally relevant and sustainable.' },
];

const tenderDocs = [
  'Technical proposal (PDF)',
  'Financial proposal (Excel or PDF)',
  'Company registration certificate',
  'Portfolio of similar projects',
  'Team CVs and qualifications',
];
---

<Layout
  title="Get involved — STEMCity Labs"
  description="Three ways to plug in: join the team, partner with us, or submit a tender. We're always looking for the right people and the right organisations."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-8 sm:pt-14 pb-10 sm:pb-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        Get involved
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        Be part of the change — <em class="text-brand italic">three ways in.</em>
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-2xl">
        Join us in transforming Africa through STEM education, innovative technology, and sustainable development. Pick the path that fits.
      </p>
    </section>

    <section class="px-6 sm:px-10 py-10 border-t border-ink/10">
      <div class="grid grid-cols-3 divide-x divide-ink/10">
        {stats.map((s) => (
          <div class="px-4 sm:px-6 first:pl-0 last:pr-0">
            <div class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em] leading-none">{s.value}</div>
            <div class="text-xs text-mute mt-3">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="careers" class="px-6 sm:px-10 py-8 sm:py-12 border-t border-ink/10 scroll-mt-12">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-4">
          <span class="font-display text-4xl text-brand font-medium">01</span>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-2">Path one</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] mt-3 leading-tight">Join the team.</h2>
          <p class="text-ink-soft mt-4 leading-relaxed">Build your career while making a difference. Opportunities span operations, programs, technology, and marketing.</p>
        </div>
        <div class="lg:col-span-8">
          <div class="p-6 sm:p-8 rounded-2xl border border-ink/10">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-3">
              <div class="font-display text-2xl font-medium">{role.title}</div>
              <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.1em] text-accent">
                <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                Open
              </span>
            </div>
            <div class="font-mono text-[11px] tracking-[0.06em] text-mute">{role.location}</div>
            <p class="text-sm text-ink-soft mt-4 leading-relaxed">{role.body}</p>

            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-8 mb-3">Apply</p>
            <ol class="space-y-2 text-sm text-ink-soft">
              {role.steps.map((s, i) => (
                <li class="flex gap-3">
                  <span class="font-mono text-brand font-medium">0{i + 1}</span>
                  <span class="leading-relaxed">{s}</span>
                </li>
              ))}
            </ol>

            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-8 mb-3">Send with</p>
            <ul class="flex flex-wrap gap-2">
              {role.requirements.map((r) => (
                <li class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink/5 text-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                  {r}
                </li>
              ))}
            </ul>

            <a href="mailto:stemcitylabs@gmail.com?subject=Operations%20Volunteer%20Application" class="mt-8 text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand transition inline-flex items-center gap-1.5">
              Email your application <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="partnerships" class="bg-ink text-paper px-6 sm:px-10 py-8 sm:py-12 scroll-mt-12">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-4">
          <span class="font-display text-4xl text-brand font-medium">02</span>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-paper/60 mt-2">Path two</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] mt-3 leading-tight">Partner with us.</h2>
          <p class="text-paper/75 mt-4 leading-relaxed">Collaborate to amplify impact — strategic partnerships, technology collaboration, community alliances.</p>
          <p class="text-sm text-paper/60 mt-4">We respond within 2 business days.</p>
        </div>
        <div class="lg:col-span-8">
          <div class="grid sm:grid-cols-3 gap-3">
            {partnershipTypes.map((t) => (
              <div class="p-6 rounded-2xl bg-paper/[0.04] border border-paper/10">
                <div class="font-display text-lg font-medium leading-snug">{t.title}</div>
                <p class="text-sm text-paper/70 mt-3 leading-relaxed">{t.body}</p>
              </div>
            ))}
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="mailto:partnerships@stemcitylabs.org" class="text-sm font-medium px-5 py-3 bg-paper text-ink rounded-full hover:bg-brand hover:text-paper transition inline-flex items-center gap-1.5">
              partnerships@stemcitylabs.org <span aria-hidden="true">→</span>
            </a>
            <a href="/contact" class="text-sm px-5 py-3 border border-paper/30 text-paper rounded-full hover:border-paper hover:bg-paper/5 transition inline-flex items-center">
              Use the contact form
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="tenders" class="px-6 sm:px-10 py-8 sm:py-12 border-t border-ink/10 scroll-mt-12">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-4">
          <span class="font-display text-4xl text-brand font-medium">03</span>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-2">Path three</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] mt-3 leading-tight">Submit a tender.</h2>
          <p class="text-ink-soft mt-4 leading-relaxed">Bid on RFPs for projects driving innovation across Africa's education landscape.</p>
        </div>
        <div class="lg:col-span-8">
          <div class="p-6 sm:p-8 rounded-2xl border border-ink/10">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
              <div class="font-display text-2xl font-medium">Current openings</div>
              <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mute">
                <span class="w-1.5 h-1.5 rounded-full bg-mute"></span>
                None at this time
              </span>
            </div>
            <p class="text-sm text-ink-soft leading-relaxed">
              We don't have open tenders right now. When new RFPs go live, they appear here. Subscribe below to be notified.
            </p>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-8 mb-3">Required documents (when applying)</p>
            <ul class="flex flex-wrap gap-2">
              {tenderDocs.map((d) => (
                <li class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink/5 text-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
                  {d}
                </li>
              ))}
            </ul>
            <a href="mailto:tenders@stemcitylabs.org" class="mt-8 text-sm font-medium px-5 py-3 border border-ink/15 rounded-full hover:border-brand hover:bg-brand/5 transition inline-flex items-center gap-1.5">
              tenders@stemcitylabs.org <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand text-brand-ink px-6 sm:px-10 py-8 sm:py-12">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand-deep mb-3">Stay connected</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] leading-tight">Get notified when new opportunities go live.</h2>
          <p class="mt-3 text-brand-deep">New roles, RFPs, partnerships, and events — straight to your inbox.</p>
        </div>
        <div class="lg:col-span-5">
          <form class="flex flex-col sm:flex-row gap-2">
            <input type="email" required placeholder="you@example.com" class="flex-1 px-4 py-3 rounded-full bg-paper text-ink placeholder:text-mute focus:outline-none focus:ring-2 focus:ring-ink/20 text-sm" />
            <button type="submit" class="text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand-ink transition inline-flex items-center justify-center gap-1.5">
              Subscribe <span aria-hidden="true">→</span>
            </button>
          </form>
          <p class="font-mono text-[10px] text-brand-deep mt-2 tracking-wider">Form is not wired up yet · placeholder during content migration</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
