---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const upcoming = [
  {
    title: 'Maker Club 2025 — Phase 3 (Uganda)',
    dates: 'August 25 – September 30, 2025',
    time: '9:00 AM – 1:00 PM',
    location: 'TechBuzz Hub, Ntinda · Kampala',
    body: 'Ignite curiosity and foster innovation in kids and young adults through hands-on STEM activities. Four learning tracks for ages 5–18.',
    tracks: [
      { name: 'Young Engineering Explorers', age: '5–7' },
      { name: 'Engineering Design Pro', age: '8–18' },
      { name: 'Coding & Design Innovators', age: '8–18' },
      { name: 'App Development', age: '9–18' },
    ],
    cta: 'Register — early bird pricing',
    status: 'Upcoming',
  },
  {
    title: 'Maker Club 2025–2026 — Phase 4 (Uganda)',
    dates: 'November 1, 2025 – January 31, 2026',
    time: '9:00 AM – 1:00 PM',
    location: 'TechBuzz Hub, Ntinda · Kampala',
    body: 'Project-based learning combining new projects with fan-favourite tracks. Emphasis on practical skills, problem-solving, and teamwork.',
    tracks: [
      { name: 'Young Engineering Explorers', age: '5–7' },
      { name: 'Engineering Design Pro', age: '8–18' },
      { name: 'Coding & Design Innovators', age: '8–18' },
      { name: 'App Development', age: '9–18' },
    ],
    cta: 'Register',
    status: 'Upcoming',
  },
];

const past = [
  {
    title: 'American Center Kampala — Panel Discussion',
    date: 'July 24, 2025',
    location: 'American Center, Kampala',
    body: '"Equipping Educators for a Tech-Driven Future" — a panel with 40+ educators on integrating technology into classrooms, supporting teachers, and preparing students for a tech-driven world. Featured STEMCity co-founder Arthur Roykin.',
    gallery: ['teachers-session', 'teachers-session-2', 'teachers-session-3'],
  },
  {
    title: 'Digital Skills Training Program',
    date: '2025',
    location: 'Uganda',
    body: 'Digital Dynamics & Electoral Processes Session — interactive workshops on technology and electoral processes with youth leaders.',
    gallery: ['dt1', 'dt2', 'dt3'],
  },
];
---

<Layout
  title="Events — STEMCity Labs"
  description="Maker Club cohorts, panel discussions, training programs. Workshops and community gatherings advancing STEM education across Africa."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-12 sm:pt-20 pb-12 sm:pb-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        Events
      </p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        Workshops, panels, and cohorts — <em class="text-brand italic">where the work happens.</em>
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-2xl">
        Learning opportunities, training programs, and community gatherings designed to advance STEM education and civic engagement across Africa.
      </p>
    </section>

    <section class="px-6 sm:px-10 py-12 sm:py-16 border-t border-ink/10">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
        <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.02em]">Upcoming events</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-mute">{upcoming.length} scheduled</span>
      </div>
      <div class="grid gap-4">
        {upcoming.map((e) => (
          <article class="p-6 sm:p-8 rounded-2xl border border-ink/10 hover:border-brand/40 transition">
            <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
              <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.1em] text-accent">
                <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                {e.status}
              </span>
              <span class="font-mono text-[11px] tracking-[0.06em] text-mute">{e.dates}</span>
            </div>
            <h3 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.015em] leading-tight">{e.title}</h3>
            <div class="grid sm:grid-cols-3 gap-3 mt-5 text-sm">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-mute">Time</p>
                <p class="font-medium mt-1">{e.time}</p>
              </div>
              <div class="sm:col-span-2">
                <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-mute">Location</p>
                <p class="font-medium mt-1">{e.location}</p>
              </div>
            </div>
            <p class="text-sm text-ink-soft leading-relaxed mt-5 max-w-2xl">{e.body}</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-6 mb-3">Tracks</p>
            <ul class="flex flex-wrap gap-2">
              {e.tracks.map((t) => (
                <li class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink/5 text-xs">
                  <span class="font-mono text-brand text-[10px]">{t.age}</span>
                  <span>{t.name}</span>
                </li>
              ))}
            </ul>
            <a href="/contact" class="mt-6 text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand transition inline-flex items-center gap-1.5">
              {e.cta} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-12 sm:py-16">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
        <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.02em]">Past events</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-paper/50">Archive</span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {past.map((e) => (
          <article class="p-6 rounded-2xl bg-paper/[0.04] border border-paper/10 flex flex-col">
            <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-paper/50">Past</span>
              <span class="font-mono text-[11px] text-paper/60">{e.date}</span>
            </div>
            <h3 class="font-display text-xl font-medium leading-snug">{e.title}</h3>
            <p class="font-mono text-[11px] text-paper/60 mt-1.5">{e.location}</p>
            <p class="text-sm text-paper/75 leading-relaxed mt-4 flex-1">{e.body}</p>
            {e.gallery && (
              <div class="mt-5 grid grid-cols-3 gap-2">
                {e.gallery.map((g) => (
                  <picture>
                    <source srcset={`/images/site/${g}.webp`} type="image/webp" />
                    <img
                      src={`/images/site/${g}.jpg`}
                      alt={`${e.title} — gallery photo`}
                      loading="lazy"
                      class="aspect-[4/3] w-full object-cover rounded-lg"
                    />
                  </picture>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="px-6 sm:px-10 py-10 border-t border-ink/10 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-2">Calendar</p>
        <p class="font-display text-lg font-medium">Subscribe to our public calendar.</p>
      </div>
      <a href="mailto:stemcitylabs@gmail.com?subject=Calendar%20subscription" class="text-sm font-medium px-5 py-3 border border-ink/15 rounded-full hover:border-brand hover:bg-brand/5 transition inline-flex items-center gap-1.5">
        Request calendar invite <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <Footer />
</Layout>
