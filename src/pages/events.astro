---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const upcoming: Array<{ title: string; dates: string; time: string; location: string; body: string; tracks: Array<{ name: string; age: string }>; cta: string; status: string }> = [];

const past = [
  {
    title: 'Maker Club 2025–2026 — Phase 4 (Uganda)',
    date: 'November 1, 2025 – January 31, 2026',
    location: 'TechBuzz Hub, Ntinda · Kampala',
    body: 'Project-based learning combining new projects with returning favourites. Four tracks for ages 5–18, with practical skills, problem-solving, and teamwork at the centre.',
    gallery: null,
  },
  {
    title: 'Maker Club 2025 — Phase 3 (Uganda)',
    date: 'August 25 – September 30, 2025',
    location: 'TechBuzz Hub, Ntinda · Kampala',
    body: 'Hands-on STEM for kids and young adults. Four learning tracks — App Development, Coding & Design Innovators, Engineering Design Pro, Young Engineering Explorers — across ages 5–18.',
    gallery: null,
  },
  {
    title: 'American Center Kampala — Panel Discussion',
    date: 'July 24, 2025',
    location: 'American Center, Kampala',
    body: '"Equipping Educators for a Tech-Driven Future" — a panel with 40+ educators on integrating technology into classrooms, supporting teachers, and preparing students for a tech-driven world. Featured STEMCity co-founder Arthur Roykin.',
    gallery: ['teachers-session', 'teachers-session-2', 'teachers-session-3'],
  },
  {
    title: 'Digital Skills Training Program',
    date: '2025',
    location: 'Uganda',
    body: 'Digital Dynamics & Electoral Processes Session — interactive workshops on technology and electoral processes with youth leaders.',
    gallery: ['dt1', 'dt2', 'dt3'],
  },
];
---

<Layout
  title="Events — STEMCity Labs"
  description="Maker Club cohorts, panel discussions, training programs. Workshops and community gatherings advancing STEM education across Africa."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-8 sm:pt-14 pb-10 sm:pb-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        Events
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        Workshops, panels, and cohorts — <em class="text-brand italic">where the work happens.</em>
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-2xl">
        Learning opportunities, training programs, and community gatherings that advance STEM education and civic engagement across Africa.
      </p>
    </section>

    <section class="px-6 sm:px-10 py-8 sm:py-12 border-t border-ink/10">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
        <h2 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em]">Upcoming</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-mute">{upcoming.length === 0 ? 'Next cohort TBA' : `${upcoming.length} scheduled`}</span>
      </div>
      {upcoming.length === 0 ? (
        <div class="p-6 sm:p-10 rounded-2xl border border-ink/10 border-dashed bg-ink/[0.02]">
          <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-mute mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-mute"></span>
            Between cohorts
          </span>
          <h3 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.015em] leading-snug max-w-2xl">
            The next Maker Club cohort and program intake will be announced via newsletter.
          </h3>
          <p class="text-ink-soft leading-relaxed mt-3 max-w-xl">
            We run cohorts in roughly quarterly cycles. Subscribe to be first to know when registration opens, or get in touch if you'd like to partner on a session, host a panel, or co-run a workshop.
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            <a href="/get-involved" class="text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand transition inline-flex items-center gap-1.5">
              Subscribe for the next cohort <span aria-hidden="true">→</span>
            </a>
            <a href="/contact" class="text-sm px-5 py-3 border border-ink/15 rounded-full hover:border-brand hover:bg-brand/5 transition inline-flex items-center">
              Partner on an event
            </a>
          </div>
        </div>
      ) : null}
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-8 sm:py-12">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
        <h2 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em]">Past events</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-paper/50">{past.length} archived</span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {past.map((e) => (
          <article class="p-6 rounded-2xl bg-paper/[0.04] border border-paper/10 flex flex-col">
            <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-paper/50">Past</span>
              <span class="font-mono text-[11px] text-paper/60">{e.date}</span>
            </div>
            <h3 class="font-display text-xl font-medium leading-snug">{e.title}</h3>
            <p class="font-mono text-[11px] text-paper/60 mt-1.5">{e.location}</p>
            <p class="text-sm text-paper/75 leading-relaxed mt-4 flex-1">{e.body}</p>
            {e.gallery && (
              <div class="mt-5 grid grid-cols-3 gap-2">
                {e.gallery.map((g) => (
                  <picture>
                    <source srcset={`/images/site/${g}.webp`} type="image/webp" />
                    <img
                      src={`/images/site/${g}.jpg`}
                      alt={`${e.title} — gallery photo`}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover rounded-lg"
                    />
                  </picture>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="px-6 sm:px-10 py-8 border-t border-ink/10 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-2">Calendar</p>
        <p class="font-display text-base sm:text-lg font-medium">Subscribe to our public calendar.</p>
      </div>
      <a href="mailto:stemcitylabs@gmail.com?subject=Calendar%20subscription" class="text-sm font-medium px-5 py-3 border border-ink/15 rounded-full hover:border-brand hover:bg-brand/5 transition inline-flex items-center gap-1.5">
        Request calendar invite <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <Footer />
</Layout>
