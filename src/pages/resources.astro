---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const planned = [
  { type: 'Report', body: 'Annual impact assessments — cohort outcomes, partner-school results, regional reach.' },
  { type: 'Toolkit', body: 'Implementation guides for schools and partners adopting our STEM curriculum.' },
  { type: 'Case study', body: 'Field reports from Maker Club, EVO, Digital Workplace and Tujulize Uganda.' },
  { type: 'Guide', body: 'Practical resources for educators integrating AI, IoT, and digital citizenship into classrooms.' },
];
---

<Layout
  title="Resources — STEMCity Labs"
  description="Reports, toolkits, and guides from STEMCity Labs' work in STEM education and civic technology across East Africa. Library in progress."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-8 sm:pt-14 pb-10 sm:pb-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        Resources
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        A library, in progress — <em class="text-brand italic">writing it down as we go.</em>
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-2xl">
        What we've learned, written down for anyone building. We're publishing the first batch alongside the next program cycle — rather than ship placeholder downloads, we'd rather wait and ship the real thing.
      </p>
    </section>

    <section class="px-6 sm:px-10 py-8 sm:py-12 border-t border-ink/10">
      <div class="p-8 sm:p-12 rounded-2xl border border-ink/10 bg-ink/[0.02]">
        <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-mute mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-mute"></span>
          In progress
        </span>
        <h2 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em] leading-tight max-w-2xl">
          No placeholder PDFs. No invented case studies.
        </h2>
        <p class="text-ink-soft leading-relaxed mt-4 max-w-xl">
          The first published resources will be drawn from real cohort data and field experience — published quarterly. Sign up below to be notified when each one lands.
        </p>
      </div>
    </section>

    <section class="px-6 sm:px-10 py-8 sm:py-12 border-t border-ink/10">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-3">
        <h2 class="font-display text-xl sm:text-2xl font-medium tracking-[-0.02em]">What's planned</h2>
        <span class="font-mono text-[11px] tracking-[0.12em] text-mute">Four formats</span>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        {planned.map((p, i) => (
          <div class="p-6 rounded-2xl border border-ink/10 border-dashed">
            <div class="flex items-baseline justify-between mb-3">
              <span class="font-display text-3xl text-brand/40 font-medium leading-none">0{i + 1}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-mute px-2 py-1 rounded-full bg-ink/5">{p.type}</span>
            </div>
            <p class="text-sm text-ink-soft leading-relaxed mt-4">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-ink text-paper px-6 sm:px-10 py-8 sm:py-12">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand mb-3">Be the first to read it</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] leading-tight">Get notified when we publish.</h2>
          <p class="mt-3 text-paper/75">Quarterly. Real things only. No newsletter padding.</p>
        </div>
        <div class="lg:col-span-5">
          <form class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              required
              placeholder="you@example.com"
              class="flex-1 px-4 py-3 rounded-full bg-paper text-ink placeholder:text-mute focus:outline-none focus:ring-2 focus:ring-paper/20 text-sm"
            />
            <button
              type="submit"
              class="text-sm font-medium px-5 py-3 bg-brand text-paper rounded-full hover:bg-paper hover:text-ink transition inline-flex items-center justify-center gap-1.5"
            >
              Subscribe <span aria-hidden="true">→</span>
            </button>
          </form>
          <p class="font-mono text-[10px] text-paper/40 mt-2 tracking-wider">Form not wired yet · pending Formspree integration</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
