---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const articles = [
  {
    id: 'american-center-panel',
    title: 'Equipping educators for a tech-driven future: insights from the American Center Kampala panel',
    date: 'July 24, 2025',
    readTime: '6 min read',
    tag: 'Latest',
    excerpt: 'A panel discussion featuring STEMCity co-founder Arthur Roykin and other education-technology experts convened at the American Center Kampala. Over 40 educators and technologists discussed integrating technology into classrooms, addressing educator concerns, and preparing students for a tech-driven world.',
    topics: ['School administrator role in tech adoption', 'Innovation hubs in schools', 'Overcoming educator apprehension', 'Support systems for teachers', 'Tech readiness in rural areas'],
  },
  {
    id: 'ai-education',
    title: 'Stop racing, start surfing: rethinking education for an AI-driven future',
    date: 'July 15, 2025',
    readTime: '8 min read',
    tag: null,
    excerpt: 'An essay on preparing students and teachers for tomorrow by prioritising adaptability over speed. Most of our secondary education system is still optimised for standardised metrics — but the World Economic Forum reports 23% of jobs will change over five years. Banning AI in classrooms is like trying to stop a tsunami with your hands.',
    topics: ['Education systems lag labour markets', 'AI disruption and new skill priorities', 'Teacher time and investment', 'Asking better questions, not just answering'],
  },
  {
    id: 'digital-divide',
    title: 'Bridging the digital divide in rural Uganda',
    date: 'July 10, 2025',
    readTime: '5 min read',
    tag: null,
    excerpt: 'An overview of STEMCity Labs initiatives bringing digital skills training to underserved communities across Uganda — comprehensive digital literacy programs addressing limited connectivity, device shortages, and insufficient training. Mobile computer labs, teacher certification, community learning centres, mentorship.',
    topics: ['Mobile computer labs', 'Teacher certification', 'Community learning centres', 'Mentorship'],
  },
];
---

<Layout
  title="News & insights — STEMCity Labs"
  description="Our latest thinking on STEM education, technology, and community impact across Africa."
>
  <Nav />

  <main>
    <section class="px-6 sm:px-10 pt-8 sm:pt-14 pb-10 sm:pb-12">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mb-5 flex items-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand"></span>
        News & insights
      </p>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium leading-[1.04] tracking-[-0.025em] max-w-4xl">
        Our latest thinking on STEM, technology, and <em class="text-brand italic">what comes next.</em>
      </h1>
      <p class="mt-6 text-base sm:text-lg leading-relaxed text-ink-soft max-w-2xl">
        Field notes, essays, and panel reports from across Africa's education and civic-tech landscape.
      </p>
    </section>

    <section class="px-6 sm:px-10 py-10 sm:py-14 border-t border-ink/10">
      <div class="grid gap-4">
        {articles.map((a, i) => (
          <article id={a.id} class="group p-6 sm:p-8 rounded-2xl border border-ink/10 hover:border-brand/40 hover:bg-brand/[0.02] transition scroll-mt-12">
            <div class="flex items-center gap-3 flex-wrap mb-4">
              {a.tag && (
                <span class="font-mono text-[10px] uppercase tracking-[0.1em] px-2.5 py-1 rounded-full bg-brand text-paper">{a.tag}</span>
              )}
              <span class="font-mono text-[11px] text-mute tracking-[0.06em]">{a.date}</span>
              <span class="font-mono text-[11px] text-mute tracking-[0.06em]">·</span>
              <span class="font-mono text-[11px] text-mute tracking-[0.06em]">{a.readTime}</span>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.015em] leading-tight max-w-3xl">{a.title}</h2>
            <p class="text-base text-ink-soft leading-relaxed mt-5 max-w-2xl">{a.excerpt}</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-mute mt-6 mb-3">In this piece</p>
            <ul class="flex flex-wrap gap-2">
              {a.topics.map((t) => (
                <li class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-ink/5 text-xs">
                  <span class="w-1 h-1 rounded-full bg-mute"></span>
                  {t}
                </li>
              ))}
            </ul>
            <span class="mt-6 text-sm font-medium text-brand inline-flex items-center gap-1.5 group-hover:gap-2 transition-all">
              Full article coming soon <span aria-hidden="true">→</span>
            </span>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-brand text-brand-ink px-6 sm:px-10 py-10 sm:py-14">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-brand-deep mb-3">Newsletter</p>
          <h2 class="font-display text-2xl sm:text-3xl font-medium tracking-[-0.025em] leading-tight">New piece, every couple of weeks.</h2>
          <p class="mt-3 text-brand-deep">Essays, panel notes, and what we're learning across the continent.</p>
        </div>
        <div class="lg:col-span-5">
          <form class="flex flex-col sm:flex-row gap-2">
            <input type="email" required placeholder="you@example.com" class="flex-1 px-4 py-3 rounded-full bg-paper text-ink placeholder:text-mute focus:outline-none focus:ring-2 focus:ring-ink/20 text-sm" />
            <button type="submit" class="text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand-ink transition inline-flex items-center justify-center gap-1.5">
              Subscribe <span aria-hidden="true">→</span>
            </button>
          </form>
          <p class="font-mono text-[10px] text-brand-deep mt-2 tracking-wider">Form is not wired up yet · placeholder during content migration</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
