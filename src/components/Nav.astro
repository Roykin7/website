---
const { pathname } = Astro.url;

const links = [
  { href: '/challenges', label: 'Challenges' },
  { href: '/programs', label: 'Programs' },
  { href: '/goals', label: 'Goals' },
  { href: '/stories', label: 'Stories' },
  { href: '/events', label: 'Events' },
  { href: '/news', label: 'News' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md px-6 sm:px-10 py-4 flex items-center justify-between border-b border-ink/10 gap-4">
  <a href="/" class="flex items-center gap-2 font-medium flex-shrink-0">
    <span class="inline-block w-3 h-3 rounded-full bg-brand"></span>
    <span class="font-display text-lg tracking-tight">STEMCity Labs</span>
  </a>

  <nav class="hidden lg:flex gap-5 text-sm">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'transition hover:text-brand',
          isActive(l.href) ? 'text-brand' : 'text-ink',
        ]}
      >
        {l.label}
      </a>
    ))}
  </nav>

  <div class="flex items-center gap-2 flex-shrink-0">
    <a
      href="/get-involved"
      class="hidden sm:inline-flex text-xs font-medium px-3.5 py-2 bg-ink text-paper rounded-full hover:bg-brand transition items-center gap-1.5"
    >
      Get involved <span aria-hidden="true">→</span>
    </a>
    <button
      type="button"
      id="mobileNavToggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileNavPanel"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-ink/15 hover:border-ink/40 hover:bg-ink/5 transition"
    >
      <svg id="mobileNavIconOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-5 h-5">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="13" x2="20" y2="13" />
        <line x1="4" y1="19" x2="20" y2="19" />
      </svg>
      <svg id="mobileNavIconClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-5 h-5 hidden">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobileNavPanel"
  class="lg:hidden fixed inset-x-0 top-[57px] bottom-0 z-40 bg-paper border-t border-ink/10 overflow-y-auto transition-opacity duration-200 opacity-0 pointer-events-none"
>
  <nav class="px-6 py-6 flex flex-col">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'py-3 border-b border-ink/10 font-display text-2xl tracking-tight transition hover:text-brand',
          isActive(l.href) ? 'text-brand' : 'text-ink',
        ]}
      >
        {l.label}
      </a>
    ))}
    <a
      href="/get-involved"
      class="mt-6 text-sm font-medium px-5 py-3 bg-ink text-paper rounded-full hover:bg-brand transition inline-flex items-center justify-center gap-1.5 self-start"
    >
      Get involved <span aria-hidden="true">→</span>
    </a>
    <div class="mt-8 pt-6 border-t border-ink/10 flex flex-col gap-2 text-sm text-ink-soft">
      <a href="/contact" class="hover:text-brand">Contact</a>
      <a href="/donate" class="hover:text-brand">Donate</a>
      <a href="/resources" class="hover:text-brand">Resources</a>
      <a href="/privacy" class="hover:text-brand">Privacy</a>
      <a href="/cookies" class="hover:text-brand">Cookies</a>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById('mobileNavToggle');
  const panel = document.getElementById('mobileNavPanel');
  const iconOpen = document.getElementById('mobileNavIconOpen');
  const iconClose = document.getElementById('mobileNavIconClose');

  function setOpen(open: boolean) {
    if (!panel || !toggle || !iconOpen || !iconClose) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    if (open) {
      panel.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    } else {
      panel.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('opacity-100');
      document.body.style.overflow = '';
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Close on link click (so it doesn't stay open after navigation)
  panel?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  // Close if resized up to desktop while open
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setOpen(false);
  });
</script>
