---
const sections = [
  {
    label: 'Programs',
    links: [
      { href: '/programs#stem-education', label: 'STEM Education' },
      { href: '/programs#civic-technology', label: 'Civic Technology' },
      { href: '/programs#entrepreneurship', label: 'Entrepreneurship' },
      { href: '/goals', label: 'Goals & targets' },
    ],
  },
  {
    label: 'Community',
    links: [
      { href: '/events', label: 'Events' },
      { href: '/news', label: 'News & insights' },
      { href: '/stories', label: 'Stories' },
      { href: '/resources', label: 'Resources' },
    ],
  },
  {
    label: 'Connect',
    links: [
      { href: '/about', label: 'About' },
      { href: '/challenges', label: 'Challenges' },
      { href: '/get-involved', label: 'Get involved' },
      { href: '/get-involved#careers', label: 'Careers' },
      { href: '/get-involved#partnerships', label: 'Partnerships' },
      { href: '/donate', label: 'Donate' },
      { href: '/contact', label: 'Contact' },
    ],
  },
];

const social = [
  { name: 'X', href: 'https://x.com/stemcitylabs_HQ' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/stemcity-labs/' },
];

const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper px-6 sm:px-10 pt-14 pb-8 mt-0">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 mb-14">
    <div class="lg:col-span-4">
      <a href="/" class="flex items-center gap-2 font-medium">
        <span class="inline-block w-3 h-3 rounded-full bg-brand"></span>
        <span class="font-display text-xl tracking-tight">STEMCity Labs</span>
      </a>
      <p class="font-display text-lg text-paper/80 mt-5 leading-snug max-w-sm">
        Where Africa's makers, students, and founders build what's next.
      </p>
      <address class="text-sm text-paper/60 mt-6 not-italic leading-relaxed">
        TechBuzz Hub, Ntinda · Plot 668 Kayondo Road<br />
        Kampala, Uganda<br />
        <a href="mailto:stemcitylabs@gmail.com" class="hover:text-brand transition">stemcitylabs@gmail.com</a><br />
        <a href="tel:+256752025145" class="hover:text-brand transition">+256 752 025 145</a>
      </address>
    </div>

    <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-6 lg:gap-10">
      {sections.map((s) => (
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-paper/40 mb-4">{s.label}</p>
          <ul class="space-y-2.5">
            {s.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-paper/80 hover:text-brand transition">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="border-t border-paper/10 pt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-paper/50">
    <span>© {year} STEMCity Labs. All rights reserved.</span>
    <div class="flex gap-4">
      {social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-brand transition">{s.name}</a>
      ))}
    </div>
  </div>
</footer>
