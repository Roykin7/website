---
const groups = [
  {
    label: 'Explore',
    links: [
      { href: '/programs', label: 'Programs' },
      { href: '/goals', label: 'Goals' },
      { href: '/challenges', label: 'Challenges' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    label: 'Community',
    links: [
      { href: '/events', label: 'Events' },
      { href: '/news', label: 'News' },
      { href: '/stories', label: 'Stories' },
      { href: '/resources', label: 'Resources' },
    ],
  },
  {
    label: 'Engage',
    links: [
      { href: '/get-involved', label: 'Get involved' },
      { href: '/contact', label: 'Contact' },
      { href: '/donate', label: 'Donate' },
    ],
  },
];

const legal = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/cookies', label: 'Cookies' },
];

const social = [
  { name: 'X', href: 'https://x.com/stemcitylabs_HQ' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/stemcity-labs/' },
];

const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper px-6 sm:px-10 pt-10 pb-6">
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-10 mb-6">
    <div class="lg:col-span-4">
      <a href="/" class="flex items-center gap-2 font-medium">
        <span class="inline-block w-3 h-3 rounded-full bg-brand"></span>
        <span class="font-display text-lg tracking-tight">STEMCity Labs</span>
      </a>
      <p class="font-display text-base sm:text-lg text-paper/85 mt-4 leading-snug max-w-xs tracking-tight">
        Where Africa's makers, students, and founders build what's next.
      </p>
      <p class="text-sm text-paper/60 mt-4">
        Kampala, Uganda · <a href="mailto:stemcitylabs@gmail.com" class="hover:text-brand transition">stemcitylabs@gmail.com</a>
      </p>
    </div>

    <div class="lg:col-span-8 grid grid-cols-3 gap-4 sm:gap-8 lg:mt-1">
      {groups.map((g) => (
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-paper/40 mb-3">{g.label}</p>
          <ul class="space-y-1.5">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-paper/80 hover:text-brand transition">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="border-t border-paper/10 pt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-paper/50">
    <span>© {year} STEMCity Labs</span>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {legal.map((l) => (
        <a href={l.href} class="hover:text-brand transition">{l.label}</a>
      ))}
      <span class="text-paper/20" aria-hidden="true">·</span>
      {social.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-brand transition">{s.name}</a>
      ))}
    </div>
  </div>
</footer>
